* text=auto

# Shell scripts must stay LF-only so they run on Linux and macOS.
*.sh text eol=lf
*.bat text eol=crlf
*.py text eol=lf
*.html text eol=lf
*.js text eol=lf
*.css text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.txt text eol=lf
Dockerfile text eol=lf
.gitignore text eol=lf
.dockerignore text eol=lf
.gitattributes text eol=lf
LICENSE text eol=lf
web/vendor/** -whitespace
